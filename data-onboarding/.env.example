# Copy to .env and fill in. NEVER commit .env.
# All variables use the VTL_ prefix and are read by src/vtl_pipeline/settings.py

# --- Environment ---
VTL_ENV=local                      # local | staging | prod
VTL_LOG_LEVEL=INFO

# --- Qdrant ---
VTL_QDRANT_URL=http://localhost:6333
VTL_QDRANT_API_KEY=

# --- Postgres (state store: hashes, cursors, ingest status) ---
VTL_POSTGRES_DSN=postgresql://postgres:postgrespassword@localhost:5432/vtl_pipeline

# --- Object storage (MinIO locally, AWS S3 in prod) ---
VTL_S3_ENDPOINT_URL=http://localhost:9000    # leave empty for real AWS S3
VTL_S3_ACCESS_KEY=minioadmin
VTL_S3_SECRET_KEY=minioadminpassword
VTL_S3_REGION=us-east-1

# --- Message queue ---
VTL_AMQP_URL=amqp://guest:guest@localhost:5672/

# --- Slack ---
VTL_SLACK_BOT_TOKEN=
VTL_SLACK_SIGNING_SECRET=

# --- Jira ---
VTL_JIRA_BASE_URL=
VTL_JIRA_EMAIL=
VTL_JIRA_API_TOKEN=
VTL_JIRA_WEBHOOK_SECRET=

# --- Microsoft Graph (SharePoint / OneDrive) ---
VTL_MS_TENANT_ID=
VTL_MS_CLIENT_ID=
VTL_MS_CLIENT_SECRET=

# --- Embeddings ---
VTL_EMBEDDING_API_KEY=             # only if using a hosted embedding provider

# --- API auth (JWT verification; groups are read from the token only) ---
VTL_JWT_ISSUER=
VTL_JWT_AUDIENCE=
VTL_JWT_JWKS_URL=